# CityGuard V3 — Docker Compose Environment Configuration (Dev/Test ONLY)
# Copy this file to `.env` in `database/` and set a local password before running `docker compose`.
# NEVER commit `.env` or real passwords to Git.

# Host port bound on 127.0.0.1 (Default 5433 to avoid conflict with local PostgreSQL on 5432)
CITYGUARD_DB_PORT=5433

# Target database name and application owner inside the Docker container
CITYGUARD_DB_NAME=cityguard_v3_dev
CITYGUARD_DB_USER=cityguard

# Required: replace placeholder in your local `.env` file
CITYGUARD_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
