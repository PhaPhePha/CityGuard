SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cityguard_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=your_super_secret_key_minimum_256_bits_for_production
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
# Đường dẫn file Service Account Key tải từ Firebase Console (để ngoài Git)
FIREBASE_CREDENTIALS_PATH=D:/Keys/cityguard-firebase.json
GOOGLE_APPLICATION_CREDENTIALS=D:/Keys/cityguard-firebase.json