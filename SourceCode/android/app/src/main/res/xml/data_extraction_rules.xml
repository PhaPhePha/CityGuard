<?xml version="1.0" encoding="utf-8"?>
<!-- TV2 - Thịnh: không sao lưu/chuyển token DataStore sang máy khác; giữ các file cấu hình gốc. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cityguard_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cityguard_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
